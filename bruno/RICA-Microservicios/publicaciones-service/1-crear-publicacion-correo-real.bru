meta {
  name: 1. Crear publicación (correo real, registrado en investigadores-service)
  type: http
  seq: 1
}

post {
  url: {{publicacionesUrl}}/api/publicaciones
  body: json
  auth: none
}

headers {
  content-type: application/json
}

body:json {
  {
    "investigadorCorreo": "rosa.zarate@uptc.edu.co",
    "titulo": "Sinergia de los moscos",
    "tipo": "articulo",
    "anio": 2025,
    "detalles": {
      "revista": "Revista De Insectos empoderados",
      "doi": "10.1234/rcc.2025.117"
    }
  }
}
