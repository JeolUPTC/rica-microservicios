meta {
  name: 1. Crear publicación (correo real, registrado en investigadores-service)
  type: http
  seq: 1
}

post {
  url: {{publicacionesUrl}}/api/publicaciones
  body: json
  auth: none
}

headers {
  content-type: application/json
}

body:json {
  {
    "investigadorCorreo": "luis.mora@uptc.edu.co",
